###############################################################################
# WINE
###############################################################################
alias wine_tty='if ls -l /dev/ttyUSB*; then \
                  set -x;\
                  j=1 ;\
                  for i in /dev/ttyUSB*; do \
                    sudo chmod 666 ${i} ;\
                    com_wine=~/.wine/dosdevices/com${j} ;\
                    rm ${com_wine} ;\
                    ln -s ${i} ${com_wine} ;\
                    j=$((j+1)) ;\
                  done; \
                  set +x; \
                fi'

                # Correzione colori su shell con sfondo nero
