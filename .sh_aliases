  webravo-deployement-cluster --zone europe-west2-b --project webravo-175810 \
  && kubectl port-forward --namespace staging $(kubectl get pod --namespace \
  staging --selector="app=api-providers-npps,environment=staging,tier=api" \
  --output jsonpath="{.items[0].metadata.name}") 5002:5002'

function home_backup_hd() {
    backupSupport="$(realpath $1)"

    if [ ! -d $backupSupport ]; then
      echo 'missing backup support'
      return 1
    fi

    backupFolder="$(hostname)-$(date -u +"%Y-%m-%d")"
    backupPath="${backupSupport}/linuxbackup/${backupFolder}"

    wget https://gist.githubusercontent.com/alefontani/b6b2383f8f9bec49ee0aad2873e1da12/raw/7b514531c33de63427f5a11676301a1490545ef3/rsync-homedir-excludes.txt -O /var/tmp/ignorelist

    backupHomeFolder="${backupPath}/home/$USER/"
    mkdir -p $backupHomeFolder

    rsync -aP --exclude-from=/var/tmp/ignorelist /home/$USER/ $backupHomeFolder

    # zip -r ${backupHomeFolder}.zip ${backupHomeFolder}

    # backupLinuxdataFolder="${backupPath}/linuxdata/"
    # if [ -d ${backupLinuxdataFolder} ]; then
    #   wget  https://raw.githubusercontent.com/alefontani/rsync-homedir-excludes/master/rsync-linuxdatadir-excludes.txt -O /var/tmp/ignorelist
    #   mkdir -p $backupLinuxdataFolder
    #   rsync -aP --exclude-from=/var/tmp/ignorelist /media/$USER/linuxdata/ $backupLinuxdataFolder
    # fi
}

