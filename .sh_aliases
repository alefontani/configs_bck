  webravo-eu-production-cluster --zone europe-west2-b --project webravo-175810 \
  && kubectl port-forward --namespace production $(kubectl get pod --namespace \
  production --selector="app=api-providers-npps,environment=production,tier=api" \
  --output jsonpath="{.items[0].metadata.name}") 5002:5002'

