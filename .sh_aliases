function sony_6300_sd_to_storage()
{
  local DISK_6300=$1
  local DESTINATION=$2

  if [ "$DESTINATION" = "HD" ]; then
    DESTINATION='/home/ale/Pictures/photos_6300'
  elif [ "$DESTINATION" = "T5" ]; then
    DESTINATION='/media/ale/samsung_t5/photos_6300'
  else
    echo 'missing destination'
    return 1
  fi

  for file in ${DISK_6300}/* ${DISK_6300}/**/*; do
    if [ -d "$file" ]; then
      continue
    fi

    local creationDate=$(stat -c "%y" ${file} | awk '{print $1}')
    local filename=$(basename -- "$file")
    local extension="${filename##*.}"
    local dir="${DESTINATION}/${creationDate}/${extension}"
    mkdir -p ${dir}
    rsync -lptgoDv -P ${file} ${dir}/
  done
}

function sony_6300_hd_to_t5()
{
  rsync -av -P /home/ale/Pictures/photos_6300 /media/ale/samsung_t5
  sync
}

###############################################################################
# GIT
###############################################################################
# alias grc="git log --oneline --all --graph --decorate"
alias gmnff="git merge --no-ff"

function git_trim_staged_whitespaces()
{
  # --- raccogli i file staged in un array ---
  if [ -n "${ZSH_VERSION-}" ]; then
    emulate -L zsh
    typeset -a files
    staged_raw=$(git diff --cached --name-only -z --diff-filter=ACM)
    files=("${(0)staged_raw}")   # split NUL → array (zsh)
  elif [ -n "${BASH_VERSION-}" ]; then
    files=()
    while IFS= read -r -d '' f; do
      files+=("$f")              # accumula in array (bash)
    done < <(git diff --cached --name-only -z --diff-filter=ACM)
  else
    echo "Errore: usa bash o zsh per eseguire questo script." >&2
    exit 1
  fi

  # --- se non c'è nulla di staged, esci pulito ---
  if [ "${#files[@]}" -eq 0 ]; then
    echo "Nessun file staged da pulire."
    exit 0
  fi

  echo "File staged trovati: ${#files[@]}"

  # --- pulizia: solo file testuali; rimuove trailing whitespace (no git add) ---
  for f in "${files[@]}"; do
    if [ -f "$f" ]; then
      echo "Pulizia: $f"
     git stripspace -s < "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    fi
  done

  echo "Fatto. Verifica le modifiche e decidi tu se fare 'git add'."
}

