function home_backup_t5() {
    backupSupport="/media/$USER/samsung_t5"

    if [ ! -d $backupSupport ]; then
        return 1
    fi

    backupFolder="$backupSupport/linuxbackup/$(hostname)-$(date -u +"%Y-%m-%d")"

    wget https://raw.githubusercontent.com/alefontani/rsync-homedir-excludes/master/rsync-homedir-excludes.txt -O /var/tmp/ignorelist

    backupHomeFolder="${backupFolder}/home/$USER/"
    mkdir -p $backupHomeFolder
    rsync -aP --exclude-from=/var/tmp/ignorelist /home/$USER/ $backupHomeFolder

    wget  https://raw.githubusercontent.com/alefontani/rsync-homedir-excludes/master/rsync-linuxdatadir-excludes.txt -O /var/tmp/ignorelist
    backupLinuxdataFolder="${backupFolder}/linuxdata/"
    mkdir -p $backupLinuxdataFolder
    rsync -aP --exclude-from=/var/tmp/ignorelist /media/$USER/linuxdata/ $backupLinuxdataFolder
}

function home_backup_hellmachine () {
    if nmap 192.168.1.104 -PN -p ssh | grep -q open ; then
        backupSupport="ale@192.168.1.104"
    elif nmap hellmachine-ale.duckdns.org -PN -p ssh | grep -q open ; then
        backupSupport="ale@hellmachine-ale.duckdns.org"
    else
        return 1
    fi

    backupFolder="/media/wdRed1/linuxbackup/$(hostname)-$(date -u +"%Y-%m-%d")"

    wget  https://raw.githubusercontent.com/alefontani/rsync-homedir-excludes/master/rsync-homedir-excludes.txt -O /var/tmp/ignorelist
    backupHomeFolder="${backupFolder}/home/$USER/"
    ssh $backupSupport mkdir -p $backupHomeFolder
    rsync -aP --exclude-from=/var/tmp/ignorelist /home/$USER/ ${backupSupport}:${backupHomeFolder}

    wget https://raw.githubusercontent.com/alefontani/rsync-homedir-excludes/master/rsync-linuxdatadir-excludes.txt -O /var/tmp/ignorelist
    backupLinuxdataFolder="${backupFolder}/linuxdata/"
    ssh $backupSupport mkdir -p $backupLinuxdataFolder
    rsync -aP --exclude-from=/var/tmp/ignorelist /media/$USER/linuxdata/ ${backupSupport}:${backupLinuxdataFolder}
}

function dsize()
{
  dir=$(pwd)
  if [ "$1" != "" ]; then
          dir=$1
  fi
  echo $(du -hcs $dir)
}

function sony_wf_1000xm3()
{
  echo -e "disconnect 94:DB:56:1C:FA:C3\n" | bluetoothctl
  sleep 5
  echo -e "connect 94:DB:56:1C:FA:C3\n" | bluetoothctl
  sleep 10
  bt_dev_index=`pacmd list-cards | grep bluez_card.94_DB_56_1C_FA_C3 -B1 | grep index | awk '{print $2}'`
  pacmd set-card-profile $bt_dev_index a2dp_sink
}

function sony_6300_sd_to_hd()
{
  local DISK_6300=$1

  for file in ${DISK_6300}/DCIM/100MSDCF/*; do
    creationDate=$(stat -c "%y" ${file} | awk '{print $1}')
    rsync -av -P ${file} /home/ale/Pictures/photos_6300/${creationDate}/
  done
  for file in ${DISK_6300}/PRIVATE/AVCHD/BDMV/STREAM/*; do
    creationDate=$(stat -c "%y" ${file} | awk '{print $1}')
    rsync -av -P ${file} /home/ale/Pictures/photos_6300/${creationDate}/videos/
  done
  for file in ${DISK_6300}/PRIVATE/M4ROOT/CLIP/*; do
    creationDate=$(stat -c "%y" ${file} | awk '{print $1}')
    rsync -av -P ${file} /home/ale/Pictures/photos_6300/${creationDate}/videos/
  done
}

function sony_6300_sd_to_hd_2()
{
  local DISK_6300=$1

  for file in ${DISK_6300}/* ${DISK_6300}/**/*; do
    if [ -d "$file" ]; then
      continue
    fi

    local creationDate=$(stat -c "%y" ${file} | awk '{print $1}')
    local filename=$(basename -- "$file")
    local extension="${filename##*.}"
    local dir="/home/ale/Pictures/photos_6300/${creationDate}/${extension}"
    mkdir -p ${dir}
    rsync -lptgoDv -P ${file} ${dir}/
    # cp ${file} ${dir}/
  done
}

function sony_6300_hd_to_t5()
{
  rsync -av -P /home/ale/Pictures/photos_6300 /media/ale/samsung_t5
  sync
}

